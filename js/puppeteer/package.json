{
  "name": "watcher-automation-puppeteer-test",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "autoAnalyzeMode": "mocha --reporter allure-mocha tests/autoAnalyzeMode.js --timeout 180s",
    "manualMode": "mocha --require ts-node/register --reporter allure-mocha tests/manualMode.js --timeout 180s",
    "axeConfigurations": "mocha --require ts-node/register --reporter allure-mocha tests/axeConfigurations.js --timeout 180s",
    "excludeURLs": "mocha --require ts-node/register --reporter allure-mocha tests/excludeURLs.js --timeout 180s",
    "configureOverrides": "mocha --require ts-node/register --reporter allure-mocha tests/configureOverrides.js --timeout 180s",
    "wrapMethods": "mocha --require ts-node/register --reporter allure-mocha tests/wrapMethods.js --timeout 180s",
    "edgeCases": "mocha --require ts-node/register --reporter allure-mocha tests/edgeCases.js --timeout 180s",
    "test": "(yarn run autoAnalyzeMode || true) && (yarn run manualMode || true) && (yarn run axeConfigurations || true) && (yarn run excludeURLs || true) && (yarn run configureOverrides || true) && (yarn run wrapMethods || true) && (yarn run edgeCases || true)"
  },
  "devDependencies": {
    "@axe-core/watcher": "^3.22.0-next.fc61317d",
    "@types/mocha": "^10.0.10",
    "allure-commandline": "^2.34.1",
    "allure-mocha": "^3.3.2",
    "chai": "^5.3.1",
    "mocha": "^11.7.1",
    "mocha-allure-reporter": "^1.4.0",
    "mochawesome": "^7.1.3",
    "puppeteer": "^24.16.2"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^17.2.1",
    "winston": "^3.18.3"
  }
}
