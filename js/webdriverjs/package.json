{
  "name": "watcher-automation-wdjs-test",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "edgeCases": "mocha --reporter allure-mocha --timeout 100s tests/edgeCases.js",
    "autoAnalyzeMode": "mocha --reporter allure-mocha --timeout 180s tests/autoAnalyzeMode.js",
    "manualMode": "mocha --reporter allure-mocha --timeout 180s tests/manualMode.js",
    "excludeURLs": "mocha --reporter allure-mocha --timeout 180s tests/excludeURLs.js",
    "configureOverrides": "mocha --reporter allure-mocha --timeout 180s tests/configureOverrides.js",
    "wrapMethods": "mocha --reporter allure-mocha --timeout 180s tests/wrapMethods.js",
    "axeConfigurations": "mocha --reporter allure-mocha --timeout 180s tests/axeConfigurations.js",
    "test-all": "(npm run autoAnalyzeMode || true) && (npm run manualMode || true) && (npm run axeConfigurations || true) && (npm run excludeURLs || true) && (npm run configureOverrides || true) && (npm run wrapMethods || true) && (npm run edgeCases || true)",
    "allure:report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@axe-core/watcher": "4.0.0-rc.0f7eb327",
    "@types/selenium-webdriver": "latest",
    "allure-commandline": "^2.34.1",
    "allure-mocha": "^3.3.2",
    "chai": "^4",
    "chromedriver": "latest",
    "mocha": "^10.6.0",
    "mocha-allure-reporter": "^1.4.0",
    "selenium-webdriver": "^4.22.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^17.2.1",
    "winston": "^3.18.3"
  }
}
