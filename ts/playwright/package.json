{
  "name": "watcher-automation-playwright-basic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "autoAnalyzeMode": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/autoAnalyzeMode.test.ts --timeout 180s",
    "axeConfigurations": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/axeConfigurations.test.ts --timeout 180s",
    "configureOverrides": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/configureOverrides.test.ts --timeout 180s",
    "edgeCases": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/edgeCases.test.ts --timeout 180s",
    "excludeURLs": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/excludeURLs.test.ts --timeout 180s",
    "manualMode": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/manualMode.test.ts --timeout 180s",
    "wrapMethods": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/wrapMethods.test.ts --timeout 180s",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"},
  "devDependencies": {
    "@axe-core/watcher": "3.23.0-next.86c61d3a",
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.34.1",
    "allure-mocha": "^3.3.3",
    "allure-playwright": "^3.0.0",
    "chai": "^5.3.1",
    "mocha": "^11.7.2",
    "mochawesome": "^7.1.3",
    "playwright": "latest",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^17.2.1",
    "winston": "^3.18.3"
  }
}
