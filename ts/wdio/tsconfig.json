{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node", "mocha", "chai", "@wdio/types"],
    "baseUrl": ".",
    "paths": {
      "@resources/*": ["resources/*"],
      "@global/*": ["global/*"],
      "utils/*": ["utils/*"]
    }
  },
  "include": [
    "tests/**/*",
    "utils/**/*",
    "resources/**/*",
    "global/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "allure-report",
    "allure-results"
  ]
}

