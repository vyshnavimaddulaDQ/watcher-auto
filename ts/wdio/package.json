{
  "name": "watcher-automation-wdio-basic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "autoAnalyzeMode": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/autoAnalyzeMode.test.ts",
    "manualMode": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/manualMode.test.ts",
    "axeConfigurations": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/axeConfigurations.test.ts",
    "excludeURLs": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/excludeURLs.test.ts",
    "configureOverrides": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/configureOverrides.test.ts",
    "wrapMethods": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/wrapMethods.test.ts",
    "edgeCases": "mocha --require ts-node/register --require tsconfig-paths/register --reporter allure-mocha tests/edgeCases.test.ts",
    "test-all": "(npm run autoAnalyzeMode || true) && (npm run manualMode || true) && (npm run axeConfigurations || true) && (npm run excludeURLs || true) && (npm run configureOverrides || true) && (npm run wrapMethods || true) && (npm run edgeCases || true)",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@axe-core/watcher": "^3.23.0-next.86c61d3a",
    "@wdio/cli": "^9.19.1",
    "@wdio/types": "^9.19.1",
    "webdriverio": "^9.19.1",
    "ts-node": "^10.9.2",
    "mocha": "^10.6.0",
    "allure-commandline": "^2.27.0",
    "allure-mocha": "3.3.2",
    "@types/mocha": "^10.0.10",
    "@types/chai": "^4.3.14",
    "@types/node": "^20.0.0",
    "chai": "^5.3.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0",
    "playwright": "^1.48.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^17.2.1",
    "winston": "^3.18.3"
  }
}
