{
  "name": "watcher-automation-playwright-test-basic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "autoAnalyzeMode": "playwright test tests/autoAnalyzeMode.test.ts --reporter=line,allure-playwright --timeout=180000",
    "axeConfigurations": "playwright test tests/axeConfigurations.test.ts --reporter=line,allure-playwright --timeout=180000",
    "configureOverrides": "playwright test tests/configureOverrides.test.ts --reporter=line,allure-playwright --timeout=180000",
    "edgeCases": "playwright test tests/edgeCases.test.ts --reporter=line,allure-playwright --timeout=180000",
    "excludeURLs": "playwright test tests/excludeURLs.test.ts --reporter=line,allure-playwright --timeout=180000",
    "manualMode": "playwright test tests/manualMode.test.ts --reporter=line,allure-playwright --timeout=180000",
    "wrapMethods": "playwright test tests/wrapMethods.test.ts --reporter=line,allure-playwright --timeout=180000",
    "test-all": "(npm run autoAnalyzeMode || true) && (npm run manualMode || true) && (npm run axeConfigurations || true) && (npm run excludeURLs || true) && (npm run configureOverrides || true) && (npm run wrapMethods || true) && (npm run edgeCases || true)",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
   
  },
  "devDependencies": {
    "@axe-core/watcher": "^3.23.0-next.86c61d3a",
    "@playwright/test": "latest",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^2.15.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^17.2.1",
    "winston": "^3.18.3"
  }
}
